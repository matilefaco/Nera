# Public hostname pointing to the VM (DNS A record)
BRIDGE_PUBLIC_HOST=wa.usenera.com

# WAHA
WAHA_SESSION=default
# x86 VPS/Google:
WAHA_IMAGE=devlikeapro/waha:noweb-2026.8.1
# Oracle Ampere A1 / ARM: use this instead:
# WAHA_IMAGE=devlikeapro/waha:noweb-arm-2026.8.1
WAHA_API_KEY=replace-with-a-long-random-secret
WAHA_WEBHOOK_HMAC_KEY=replace-with-a-different-long-random-secret

# Z-API compatibility credentials.
# Set these to the same values Nera already uses so the app code does not need to change.
BRIDGE_INSTANCE_ID=replace-with-current-ZAPI_INSTANCE_ID
BRIDGE_INSTANCE_TOKEN=replace-with-current-ZAPI_INSTANCE_TOKEN
BRIDGE_CLIENT_TOKEN=replace-with-current-ZAPI_CLIENT_TOKEN

# Existing Nera inbound endpoint and webhook auth token.
NERA_ZAPI_WEBHOOK_URL=https://usenera.com/api/zapi/webhook
NERA_ZAPI_WEBHOOK_TOKEN=replace-with-current-ZAPI_WEBHOOK_TOKEN
