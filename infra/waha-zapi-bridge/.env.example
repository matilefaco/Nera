BRIDGE_PUBLIC_HOST=wa.usenera.com
WAHA_SESSION=default

# WAHA Docker image:
# AMD64 default:
WAHA_IMAGE=devlikeapro/waha:noweb-2026.8.1
# Oracle Cloud ARM64 (Ampere A1):
# WAHA_IMAGE=devlikeapro/waha:noweb-arm-2026.8.1

# Secrets for internal WAHA <-> Bridge communication
# Generate using: openssl rand -hex 32
WAHA_API_KEY=
WAHA_WEBHOOK_HMAC_KEY=

# Bridge credentials (can temporarily match existing ZAPI_* during cutover):
BRIDGE_INSTANCE_ID=
BRIDGE_INSTANCE_TOKEN=
BRIDGE_CLIENT_TOKEN=

# Destination Nera webhook settings
NERA_ZAPI_WEBHOOK_URL=https://usenera.com/api/zapi/webhook
NERA_ZAPI_WEBHOOK_TOKEN=

# During migration keep this FALSE while Z-API owns inbound.
# Enable only when Z-API inbound webhook is disabled at cutover.
BRIDGE_INBOUND_FORWARDING_ENABLED=false

